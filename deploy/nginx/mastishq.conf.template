# Mastishq — nginx site config. ${APP_DOMAIN} and ${API_DOMAIN} are filled in by server-setup.sh.
# Written for plain HTTP; `certbot --nginx` then adds HTTPS and the HTTP->HTTPS redirect automatically.

# ---------- website (React build) + same-origin /api proxy ----------
server {
    listen 80;
    listen [::]:80;
    server_name ${APP_DOMAIN};

    root /opt/mastishq/frontend;
    index index.html;

    # support attachments: up to 3 files x 5 MB
    client_max_body_size 20m;

    server_tokens off;
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "SAMEORIGIN" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header Permissions-Policy "camera=(), microphone=(), geolocation=()" always;

    gzip on;
    gzip_types text/css application/javascript application/json image/svg+xml;

    # the API, on the same address as the site (so login cookies just work, no CORS needed)
    location /api/ {
        proxy_pass http://127.0.0.1:4000;
        proxy_http_version 1.1;
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        # AI quizzes can take a minute or more to write and check
        proxy_read_timeout 180s;
        proxy_send_timeout 180s;
    }

    # built files have hashed names, so they can be cached for a year
    location /assets/ {
        try_files $uri =404;
        expires 1y;
        add_header Cache-Control "public, immutable";
        add_header X-Content-Type-Options "nosniff" always;
    }

    # everything else is the single-page app (React Router handles the URL)
    location / {
        try_files $uri $uri/ /index.html;
        add_header Cache-Control "no-cache";
        add_header X-Content-Type-Options "nosniff" always;
        add_header X-Frame-Options "SAMEORIGIN" always;
        add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    }

    # never serve hidden files
    location ~ /\. { deny all; }
}

# ---------- the API on its own address (for other apps, tools and testing) ----------
server {
    listen 80;
    listen [::]:80;
    server_name ${API_DOMAIN};

    client_max_body_size 20m;
    server_tokens off;
    add_header X-Content-Type-Options "nosniff" always;

    location / {
        proxy_pass http://127.0.0.1:4000;
        proxy_http_version 1.1;
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 180s;
        proxy_send_timeout 180s;
    }
}
