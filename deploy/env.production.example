# Copy to /etc/mastishq/api.env on the server (chmod 600). Never commit the real file.
NODE_ENV=production
PORT=4000

# Your public website address (https only). Several allowed, comma-separated.
CLIENT_URL=https://app.mastishq.ai

# MongoDB Atlas connection string (database user with readWrite on the "smartlearn" database only)
# keep the quotes: the address contains & which would otherwise be misread
MONGODB_URI="mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/smartlearn?retryWrites=true&w=majority"

# Random secret, 32+ characters. Create one with:  openssl rand -hex 32
JWT_SECRET=

# OpenAI (use a NEW key for production, with a monthly spend limit set in the OpenAI dashboard)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_VERIFY_MODEL=gpt-4.1-mini

# Google sign-in (the Web client ID; add https://app.mastishq.ai as an Authorized JavaScript origin)
GOOGLE_CLIENT_ID=

# Where support attachments are stored (outside the code folder so deploys never delete them)
UPLOAD_DIR=/var/lib/mastishq/uploads

# --- Pro plan payments (Razorpay) ---
# Key ID + secret from the Razorpay dashboard (rzp_test_... while testing, rzp_live_... for real money).
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Optional safety net: set a webhook in the dashboard to https://<your-site>/api/payments/webhook (events: payment.captured, order.paid)
# and put its secret here.
RAZORPAY_WEBHOOK_SECRET=
# Optional: PRO_PRICE_PAISE=49900  PRO_LIST_PRICE_PAISE=99900  PRO_DAYS=30  PRO_LIMIT_MULTIPLIER=3

# --- Study files (Upload file / Scan a page) ---
# Private S3 bucket for the original files. Leave S3_BUCKET empty to keep files on the server's disk instead.
# The server reaches S3 through an IAM role attached to the EC2 instance, so no AWS keys go in this file.
S3_BUCKET=
S3_REGION=ap-south-1
# Optional: AI_LIMIT_UPLOAD=10 (files/scans read per learner per day)  RAG_CONTEXT_CHARS=24000
